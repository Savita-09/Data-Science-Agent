# Copy to .env. Never commit real credentials.
APP_ENV=development
# Required in private production: use a random value of at least 32 characters.
APP_API_KEY=
# Public demos require ephemeral_storage=true and use separate public-demo subdirectories.
PUBLIC_DEMO=false
DATA_ROOT=./data
PROJECT_ROOT=./projects
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174
# AI Chat uses Groq. Set a real key only in .env or your server environment.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
# Optional OpenAI-compatible chat-completions provider; no API key is embedded in the UI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# Each analysis explicitly opts in to sharing goal, schema, and aggregate results.
MAX_JOB_SECONDS=900
MAX_MEMORY_MB=2048
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
